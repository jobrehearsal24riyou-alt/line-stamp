import React from "react";

export default function SubcategorySelector({ 
  selectedCategory, 
  middleCategoryList, 
  filteredItems, 
  selectedSubCategoryName, 
  selectedItemId, 
  handleMiddleCategoryChange, 
  setSelectedItemId, 
  theme 
}) {
  if (!selectedCategory) {
    return (
      <div className="subcategory-selector" style={{ marginTop: "24px" }}>
        <p className="label" style={{ color: theme.textMain }}>■ 1-2. 具体的なアイテム（サブカテゴリ）を選択してください</p>
        <div style={{ padding: "16px", background: theme.cardBg, borderRadius: "8px", border: `1px dashed ${theme.cardBorder}` }}>
          <p style={{ color: theme.textMuted, fontSize: "0.9rem", margin: 0 }}>
            上方の大カテゴリを選択すると、サブカテゴリの選択肢が表示されます。
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="subcategory-selector" style={{ marginTop: "24px" }}>
      <p className="label" style={{ color: theme.textMain }}>■ 1-2. 具体的なアイテム（サブカテゴリ）を選択してください</p>
      
      <div style={{ display: "flex", flexDirection: "column", gap: "20px" }}>
        {/* 📂 中カテゴリの選択ボタン */}
        <div style={{ display: "flex", gap: "10px", flexWrap: "wrap", padding: "10px 0" }}>
          {middleCategoryList.map((middleName) => {
            const isMiddleChecked = selectedSubCategoryName === middleName;
            return (
              <button
                key={middleName}
                onClick={() => handleMiddleCategoryChange(middleName)}
                style={{
                  padding: "10px 18px", borderRadius: "20px",
                  border: isMiddleChecked ? "1px solid #3b82f6" : `1px solid ${theme.cardBorder}`,
                  background: isMiddleChecked ? theme.activeBg : "transparent",
                  color: isMiddleChecked ? theme.activeText : theme.textMain, 
                  fontWeight: "600", cursor: "pointer", transition: "all 0.15s ease"
                }}
              >
                📁 {middleName}
              </button>
            );
          })}
        </div>

        {/* 📄 アイテム一覧グリッド */}
        <div className="subcategory-list" style={{ 
          background: theme.panelBg, padding: "16px", borderRadius: "8px",
          border: `1px solid ${theme.cardBorder}`, display: "grid",
          gridTemplateColumns: "repeat(auto-fill, minmax(180px, 1fr))", gap: "10px"
        }}>
          {filteredItems.map((sub) => {
            const isSubChecked = selectedItemId === sub.id;

            // 英語名をファイル名用に成形（小文字化、前後の空白削除、スペースをアンダースコアに）
            const imgFileName = sub.item_name_en
              ? sub.item_name_en.toLowerCase().trim().replace(/[\s-]+/g, "_")
              : "";

            // 🍰 画像を表示する対象の判定
            const isShortCake = imgFileName === "shortcake" || imgFileName === "short_cake";
            const isChocolateCake = imgFileName === "chocolate_cake";

            // 📂 条件に一致した画像のパスを割り当てる（画像が増えたらここに追加）
            let imgSrc = "";
            if (isShortCake) {
              imgSrc = "/items/short_cake.png";
            } else if (isChocolateCake) {
              imgSrc = "/items/chocolate_cake.png";
            }

            return (
              <div 
                key={sub.id} 
                onClick={() => setSelectedItemId(sub.id)}
                className={`style-card ${isSubChecked ? "checked" : ""}`}
                style={{ 
                  display: "flex", 
                  alignItems: "center", 
                  justifyContent: "flex-start", 
                  gap: "12px", 
                  cursor: "pointer",
                  padding: "14px 16px", 
                  borderRadius: "8px",
                  border: isSubChecked ? "2px solid #3b82f6" : `1px solid ${theme.cardBorder}`,
                  background: isSubChecked ? theme.activeBg : theme.cardBg,
                  transition: "all 0.15s ease",
                  boxSizing: "border-box",
                  width: "100%",
                  minHeight: "68px" // 画像の有無でカードの高さが変わらないよう固定
                }}
              >
                {/* 横並びを保証するコンテナ */}
                <div style={{ display: "flex", alignItems: "center", width: "100%", gap: "12px" }}>
                  
                  {/* 💡 画像パス（imgSrc）が存在するときだけ左側に画像を表示 */}
                  {imgSrc && (
                    <img 
                      src={imgSrc} 
                      alt={sub.item_name_ja}
                      style={{ 
                        width: "32px", 
                        height: "32px", 
                        objectFit: "contain", 
                        flexShrink: 0,
                        borderRadius: "4px"
                      }}
                      // 万が一ファイルがない場合の保険（非表示にする）
                      onError={(e) => { e.target.style.display = 'none'; }}
                    />
                  )}

                  {/* テキスト情報を格納するコンテナ */}
                  <div style={{ flexGrow: 1, minWidth: 0 }}>
                    <div style={{ 
                      fontSize: "0.95rem", 
                      fontWeight: "600", 
                      color: isSubChecked ? theme.activeText : theme.textMain, 
                      lineHeight: "1.2",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis"
                    }}>
                      {sub.item_name_ja}
                    </div>
                    <div style={{ 
                      fontSize: "0.75rem", 
                      color: isSubChecked ? "rgba(255,255,255,0.8)" : theme.textMuted, 
                      marginTop: "4px",
                      whiteSpace: "nowrap",
                      overflow: "hidden",
                      textOverflow: "ellipsis"
                    }}>
                      {sub.item_name_en}
                    </div>
                  </div>

                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}