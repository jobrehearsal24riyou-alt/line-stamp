{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prompt_make_projects",
  "version": "0.1.0",
  "identifier": "com.user.prompt-make-projects",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "prompt_make_projects",
        "width": 800,
        "height": 600
      }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$PICTURE/Line_stamps/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/llama-server"],
    "resources": ["binaries/*.dll", "binaries/*.gguf"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODQ0Q0U1Qzg3Mzk5NUUKUldSZW1YUEk1VXlFbTlHZ3NjSWNxSVBFZ2Ixd0RuUEVPSU9yTG0weFduMXhXNG0vdmdUbEphZTgK",
      "endpoints": [
        "https://github.com/jobrehearsal24riyou-alt/line-stamp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
